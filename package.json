{
  "name": "rediiska",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node tests/workspace.cjs && node tests/identity.mjs && node tests/ui.cjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply rediiska-db --remote",
    "db:export": "wrangler d1 export rediiska-db --remote --output rediiska-backup.sql"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "wrangler": "4.92.0",
    "typescript": "5.9.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "esbuild": "0.28.0"
  }
}